Host *
        ServerAliveInterval 30
        ServerAliveCountMax 10
#	ExitOnForwardFailure yes
	
Host alias or.fqdn.com
	HostName <ip address>
	Port <port>
	User <user>
	PreferredAuthentications publickey
	IdentityFile /home/<user>/.ssh/id_rsa
	GSSAPIAuthentication no
	Compression yes
	ControlMaster auto
	ControlPath /home/<user>/.ssh/sockets/ssh_mux_%h_%p_%r
	ControlPersist yes
#	IPQoS ef
	IPQoS cs4
	DynamicForward 60080
	LocalForward 63306 localhost:3306
	LocalForward 60667 localhost:60667
#	RemoteForward 60022 localhost:22
#	LocalForward 60066 localhost:6601

Host exampleipv6 ipv6.fqdn.com example6
        HostName <ipv6 address>
	AddressFamily inet6

        Port <port>
        User <user>
        PreferredAuthentications publickey
        IdentityFile /home/<user>/.ssh/id_rsa
        GSSAPIAuthentication no
        Compression yes

        ControlMaster auto
        ControlPath /home/<user>/.ssh/sockets/ssh_mux_%h_%p_%r
        ControlPersist yes
	IPQoS ef
        DynamicForward 60080
#	RemoteForward 60022 localhost:22
        LocalForward 63306 localhost:3306
	LocalForward 60667 localhost:60667



